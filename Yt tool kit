*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Segoe UI',Roboto,Tahoma,Arial,sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;line-height:1.6}
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:-2}
.aurora{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.aurora i{position:absolute;border-radius:50%;filter:blur(90px);opacity:.42;animation:drift 18s ease-in-out infinite alternate}
.aurora i:nth-child(1){width:420px;height:420px;background:var(--violet);top:-90px;left:-90px}
.aurora i:nth-child(2){width:380px;height:380px;background:var(--red);bottom:-110px;right:-70px;animation-delay:-6s}
.aurora i:nth-child(3){width:300px;height:300px;background:var(--cyan);top:40%;left:55%;opacity:.22;animation-delay:-12s}
@keyframes drift{to{transform:translate(70px,40px) scale(1.2)}}
nav{position:fixed;top:0;left:0;right:0;display:flex;justify-content:space-between;align-items:center;padding:12px 5%;background:rgba(6,8,24,.8);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);z-index:100;border-bottom:1px solid rgba(255,255,255,.07)}
.logo{font-size:1.4rem;font-weight:800;display:flex;align-items:center;gap:8px}
.logo .play{background:var(--red);width:34px;height:24px;border-radius:7px;display:inline-flex;align-items:center;justify-content:center;font-size:12px;box-shadow:0 0 18px var(--red)}
.logo b{background:linear-gradient(90deg,var(--red),var(--amber));-webkit-background-clip:text;background-clip:text;color:transparent}
nav ul{display:flex;gap:22px;list-style:none}
nav a{color:var(--muted);text-decoration:none;font-weight:600}
nav a:hover{color:#fff}
.hero{min-height:100vh;display:grid;grid-template-columns:1.05fr .95fr;gap:30px;align-items:center;padding:110px 5% 60px;max-width:1250px;margin:0 auto}
.badge{display:inline-block;padding:6px 16px;border:1px solid var(--cyan);border-radius:30px;color:var(--cyan);font-size:.85rem;margin-bottom:20px;background:rgba(34,211,238,.08)}
.hero h1{font-size:clamp(2.1rem,5.2vw,4rem);line-height:1.12;font-weight:900}
.hero h1 em{font-style:normal;background:linear-gradient(90deg,var(--red),var(--amber));-webkit-background-clip:text;background-clip:text;color:transparent}
.sub{color:var(--muted);font-size:1.1rem;max-width:560px;margin:18px 0 28px}
.searchbar{display:flex;width:100%;max-width:600px;background:var(--card);border:1px solid rgba(255,255,255,.15);border-radius:60px;padding:7px;box-shadow:0 20px 60px rgba(139,92,255,.3)}
.searchbar:focus-within{border-color:var(--red);box-shadow:0 20px 60px rgba(255,59,92,.35)}
.searchbar input{flex:1;background:transparent;border:none;outline:none;color:var(--text);padding:0 18px;font-size:1rem;min-width:0}
.btn{background:linear-gradient(135deg,var(--red),#ff6f87);color:#fff;border:none;padding:13px 28px;border-radius:50px;font-weight:700;font-size:1rem;cursor:pointer;font-family:inherit;box-shadow:0 8px 22px rgba(255,59,92,.35);transition:.25s}
.btn:hover{transform:translateY(-2px)}
.btn.alt{background:linear-gradient(135deg,var(--violet),#b49bff);box-shadow:0 8px 22px rgba(139,92,255,.35)}
.btn.cy{background:linear-gradient(135deg,#0ea5c6,var(--cyan));color:#001;box-shadow:0 8px 22px rgba(34,211,238,.3)}
.mini{margin-top:18px;color:var(--muted);font-size:.85rem}
.stage{perspective:1100px;height:440px;display:flex;align-items:center;justify-content:center}
.deck{position:relative;width:340px;height:380px;transform-style:preserve-3d;transform:rotateY(-18deg) rotateX(8deg);transition:transform .15s ease-out}
.fl{position:absolute;inset:0;transform-style:preserve-3d;animation:bob 5s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-14px)}}
.c3{position:absolute;border-radius:20px;border:1px solid rgba(255,255,255,.2);background:var(--card);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 30px 60px rgba(0,0,0,.5);padding:14px 16px}
.c3 small{display:block;color:var(--amber);font-weight:700;letter-spacing:1px;font-size:.7rem;margin-bottom:8px}
.ring{position:absolute;left:20px;top:30px;width:300px;height:300px;border-radius:50%;border:2px dashed rgba(139,92,255,.55);transform:translateZ(-80px);animation:ringspin 22s linear infinite}
@keyframes ringspin{from{transform:translateZ(-80px) rotate(0)}to{transform:translateZ(-80px) rotate(360deg)}}
.vid{left:10px;top:60px;width:300px;height:176px;padding:0;overflow:hidden;background:linear-gradient(135deg,#2b1a78,#ff3b5c 85%);transform:translateZ(0)}
.vid b{position:absolute;inset:0;margin:auto;width:66px;height:66px;border-radius:50%;background:#fff;color:var(--red);display:flex;align-items:center;justify-content:center;font-size:1.6rem;box-shadow:0 0 40px rgba(255,255,255,.6)}
.vid span{position:absolute;left:14px;right:14px;bottom:12px;height:5px;border-radius:5px;background:rgba(255,255,255,.3)}
.vid span::after{content:'';position:absolute;left:0;top:0;height:100%;width:42%;border-radius:5px;background:#fff}
.tagc{right:-24px;top:0;width:190px;transform:translateZ(70px)}
.hashc{left:-30px;bottom:34px;width:200px;transform:translateZ(110px)}
.ttsc{right:-24px;bottom:6px;width:180px;transform:translateZ(50px)}
.eq{display:flex;gap:4px;align-items:flex-end;height:36px}
.eq i{width:7px;border-radius:4px;background:linear-gradient(var(--cyan),var(--violet));animation:eq 1s ease-in-out infinite alternate}
.eq i:nth-child(2){animation-delay:.15s}.eq i:nth-child(3){animation-delay:.3s}.eq i:nth-child(4){animation-delay:.45s}.eq i:nth-child(5){animation-delay:.6s}.eq i:nth-child(6){animation-delay:.2s}.eq i:nth-child(7){animation-delay:.5s}
@keyframes eq{from{height:6px}to{height:34px}}
section{padding:80px 5%}
section h2{text-align:center;font-size:clamp(1.6rem,4vw,2.6rem);margin-bottom:10px}
section h2 em{font-style:normal;color:var(--amber)}
.lead{text-align:center;color:var(--muted);margin-bottom:40px}
#results{display:none}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;max-width:1150px;margin:0 auto}
.panel{background:var(--card);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:22px}
.panel.wide{grid-column:1/-1}
.panel h3{margin-bottom:12px;color:var(--amber)}
.panel img{width:100%;border-radius:12px;margin-bottom:12px}
.box{background:var(--bg2);border-radius:12px;padding:14px;white-space:pre-wrap;word-break:break-word;max-height:260px;overflow:auto}
.empty{color:var(--muted);font-style:italic}
.chips{display:flex;flex-wrap:wrap;gap:7px}
.chip{background:rgba(139,92,255,.25);border:1px solid var(--violet);padding:4px 11px;border-radius:30px;font-size:.82rem;cursor:pointer}
.chip.r{background:rgba(255,59,92,.2);border-color:var(--red)}
.tools{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:24px;max-width:1150px;margin:0 auto}
.tool{background:var(--card);border:1px solid rgba(255,255,255,.1);border-radius:22px;padding:30px 22px;opacity:0;transform:perspective(900px) rotateX(38deg) translateY(60px);transition:opacity .8s,transform .8s cubic-bezier(.2,.8,.2,1)}
.tool.show{opacity:1;transform:perspective(900px) rotateX(0) translateY(0)}
.tool .ic{font-size:2.4rem;margin-bottom:10px}
.tool p{color:var(--muted)}
.tool.soon.show{opacity:.6}
.tag{display:inline-block;margin-top:10px;font-size:.75rem;padding:3px 10px;border-radius:20px;background:rgba(255,179,64,.2);color:var(--amber)}
.tts{max-width:800px;margin:0 auto;background:var(--card);border-radius:24px;padding:28px;border:1px solid rgba(255,255,255,.1);box-shadow:0 30px 80px rgba(0,0,0,.4)}
.tts textarea{width:100%;min-height:160px;background:var(--bg2);color:var(--text);border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:14px;font-size:1.05rem;font-family:inherit;margin-bottom:14px}
.row{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:14px}
.row select,.row input[type=range]{background:var(--bg2);color:var(--text);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:10px;flex:1;min-width:130px}
.row label{font-size:.85rem;color:var(--muted)}
.btns{display:flex;flex-wrap:wrap;gap:10px}
.note{font-size:.8rem;color:var(--muted);margin-top:12px}
footer{text-align:center;padding:34px 5%;color:var(--muted);border-top:1px solid rgba(255,255,255,.07)}
.toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(120px);background:var(--red);color:#fff;padding:12px 24px;border-radius:40px;transition:.4s;z-index:200;max-width:90%;text-align:center}
.toast.on{transform:translateX(-50%) translateY(0)}
@media(max-width:850px){.hero{grid-template-columns:1fr;text-align:center;padding-top:100px}.hero-text{display:flex;flex-direction:column;align-items:center}.stage{height:360px;transform:scale(.82);margin:-10px 0 0}nav ul{display:none}}
</style>
</head>
