<script>
// YOUTUBE API KEY (already added)
var API_KEY = 'AIzaSyDYdpzispBES-8RnbBL_t-uOvbrqJcF5SE';

var vid = '';
function $(id){ return document.getElementById(id); }
function toast(m){ var t=$('toast'); t.textContent=m; t.classList.add('on'); setTimeout(function(){ t.classList.remove('on'); }, 2500); }
function getId(u){ var m=u.match(/(?:v=|youtu\.be\/|shorts\/|embed\/|live\/)([A-Za-z0-9_-]{11})/); return m ? m[1] : null; }
function copyText(t){
  var a=document.createElement('textarea'); a.value=t; document.body.appendChild(a); a.select();
  try{ document.execCommand('copy'); toast('Copied'); }catch(e){ toast('Copy failed'); }
  document.body.removeChild(a);
}
function setBox(id,t){ var e=$(id); if(t && t.trim()){ e.textContent=t; e.className='box'; } else { e.textContent='Not used in this video'; e.className='box empty'; } }
function fillChips(id,arr,cls){
  var c=$(id); c.innerHTML='';
  if(!arr.length){ c.innerHTML='<span class="empty">Not used in this video</span>'; return; }
  arr.forEach(function(x){ var s=document.createElement('span'); s.className=cls; s.textContent=x; s.onclick=function(){ copyText(x); }; c.appendChild(s); });
}

function go(){
  var id=getId($('url').value.trim());
  if(!id){ toast('Please enter a valid YouTube link'); return; }
  vid=id;
  fetch('https://www.googleapis.com/youtube/v3/videos?part=snippet&id='+id+'&key='+API_KEY)
  .then(function(r){ return r.json(); })
  .then(function(d){
    if(d.error){ toast('API error: '+d.error.message); return; }
    if(!d.items || !d.items.length){ toast('Video not found'); return; }
    var s=d.items[0].snippet, th=s.thumbnails||{};
    $('thumb').src=(th.maxres||th.standard||th.high||th.medium||th.default).url;
    $('chan').textContent='Channel: '+s.channelTitle;
    setBox('title',s.title);
    setBox('desc',s.description);
    fillChips('tags',s.tags||[],'chip');
    var found=[], seen={};
    var m=(s.title+' '+s.description).match(/#[^\s#.,!?;:()\[\]{}"']+/g)||[];
    m.forEach(function(h){ if(!seen[h]){ seen[h]=1; found.push(h); } });
    fillChips('hashes',found,'chip r');
    $('results').style.display='block';
    $('results').scrollIntoView({behavior:'smooth'});
  })
  .catch(function(){ toast('Network error, try again'); });
}

function downloadThumb(){
  if(!vid) return;
  var names=['maxresdefault','sddefault','hqdefault'], i=0;
  function tryNext(){
    if(i>=names.length){ window.open('https://img.youtube.com/vi/'+vid+'/hqdefault.jpg','_blank'); return; }
    fetch('https://img.youtube.com/vi/'+vid+'/'+names[i++]+'.jpg').then(function(r){ if(!r.ok) throw 0; return r.blob(); }).then(function(b){
      if(b.size<5000) throw 0;
      var a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download='thumbnail-'+vid+'.jpg'; a.click();
    }).catch(tryNext);
  }
  tryNext();
}

$('goBtn').onclick=go;
$('url').addEventListener('keydown',function(e){ if(e.key==='Enter') go(); });
$('dlBtn').onclick=downloadThumb;
document.querySelectorAll('[data-copy]').forEach(function(b){ b.onclick=function(){ var e=$(b.getAttribute('data-copy')); if(e.className.indexOf('empty')>-1) return toast('Nothing to copy'); copyText(e.textContent); }; });
document.querySelectorAll('[data-all]').forEach(function(b){ b.onclick=function(){ var id=b.getAttribute('data-all'); var a=[].map.call($(id).querySelectorAll('.chip'),function(e){ return e.textContent; }); if(!a.length) return toast('Nothing to copy'); copyText(id==='tags'?a.join(', '):a.join(' ')); }; });

// Hero 3D deck follows mouse, touch and scroll
(function(){
  var d=$('deck');
  function tilt(x,y){ d.style.transform='rotateY('+(-18+x*40)+'deg) rotateX('+(8-y*30)+'deg)'; }
  window.addEventListener('mousemove',function(e){ tilt(e.clientX/window.innerWidth-.5,e.clientY/window.innerHeight-.5); });
  window.addEventListener('touchmove',function(e){ var t=e.touches[0]; tilt(t.clientX/window.innerWidth-.5,t.clientY/window.innerHeight-.5); },{passive:true});
  window.addEventListener('scroll',function(){ var s=Math.min(window.scrollY/500,1); d.style.transform='rotateY('+(-18+s*40)+'deg) rotateX('+(8+s*16)+'deg)'; });
})();

// Scroll reveal for tool cards
var io=new IntersectionObserver(function(es){ es.forEach(function(e){ if(e.isIntersecting) e.target.classList.add('show'); }); },{threshold:.15});
document.querySelectorAll('.tool').forEach(function(el,i){ el.style.transitionDelay=(i%4)*0.1+'s'; io.observe(el); });

// Particle background with depth
(function(){
  var cv=$('bg'), cx=cv.getContext('2d'), W, H, pts=[], mx=0, my=0, cols=['#8b5cff','#ff3b5c','#22d3ee','#ffb340'];
  function size(){ W=cv.width=window.innerWidth; H=cv.height=window.innerHeight; }
  size(); window.addEventListener('resize',size);
  for(var i=0;i<120;i++) pts.push({x:Math.random()*2-1,y:Math.random()*2-1,z:Math.random()*2+.2,c:cols[i%4]});
  window.addEventListener('mousemove',function(e){ mx=e.clientX/W-.5; my=e.clientY/H-.5; });
  function draw(){
    cx.clearRect(0,0,W,H); var sc=window.scrollY/1500;
    pts.forEach(function(p){
      p.z-=.0035; if(p.z<.2) p.z=2.2;
      var k=1/p.z, x=W/2+(p.x+mx*.5)*W*.5*k, y=H/2+(p.y+my*.5-sc*.3)*H*.5*k;
      cx.beginPath(); cx.fillStyle=p.c; cx.globalAlpha=Math.min(1,k*.5); cx.arc(x,y,Math.max(.5,k*2.4),0,7); cx.fill();
    });
    requestAnimationFrame(draw);
  }
  draw();
})();

// Text to speech
function speak(){
  var t=$('ttsText').value.trim(); if(!t) return toast('Please type some text');
  window.speechSynthesis.cancel();
  var l=$('lang').value, code=(l==='ur')?'ur-PK':(l==='hi')?'hi-IN':'en-US';
  var voices=window.speechSynthesis.getVoices();
  var v=voices.filter(function(x){ return x.lang.toLowerCase().indexOf(l)===0; })[0];
  if(!v && l==='ur') v=voices.filter(function(x){ return /^(hi|ur|pa)/i.test(x.lang); })[0];
  var parts=t.match(/[^.!?\u06d4\n]+[.!?\u06d4\n]*/g)||[t];
  parts.forEach(function(p){
    if(!p.trim()) return;
    var u=new SpeechSynthesisUtterance(p); u.lang=code; if(v) u.voice=v; u.rate=parseFloat($('rate').value);
    window.speechSynthesis.speak(u);
  });
}
function downloadAudio(){
  var t=$('ttsText').value.trim(); if(!t) return toast('Please type some text');
  var tl=$('lang').value, chunks=[], cur='';
  (t.match(/[^.!?\u06d4\n]+[.!?\u06d4\n]*/g)||[t]).forEach(function(s){
    if((cur+s).length>180){ if(cur) chunks.push(cur.trim()); while(s.length>180){ chunks.push(s.slice(0,180)); s=s.slice(180); } cur=s; } else cur+=s;
  });
  if(cur.trim()) chunks.push(cur.trim());
  toast('Preparing audio ('+chunks.length+' parts)...');
  var bufs=[], i=0;
  function next(){
    if(i>=chunks.length){
      var a=document.createElement('a'); a.href=URL.createObjectURL(new Blob(bufs,{type:'audio/mpeg'})); a.download='yt-toolkit-voice-'+tl+'.mp3'; a.click();
      toast('Download started'); return;
    }
    fetch('https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl='+tl+'&q='+encodeURIComponent(chunks[i++]))
    .then(function(r){ if(!r.ok) throw 0; return r.arrayBuffer(); })
    .then(function(b){ bufs.push(b); next(); })
    .catch(function(){ toast('Online voice blocked here. Use Play, or host the site online and try again.'); });
  }
  next();
}
$('playBtn').onclick=speak;
$('stopBtn').onclick=function(){ window.speechSynthesis.cancel(); };
$('dlAudioBtn').onclick=downloadAudio;
</script>
</body>
